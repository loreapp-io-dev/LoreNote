{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoreNote",
  "version": "0.1.1",
  "identifier": "com.lore.lore-note",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "LoreNote",
        "width": 680,
        "height": 440,
        "minWidth": 560,
        "minHeight": 380,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}